# /etc/portcast-server.env  (chmod 600, chown portcast:portcast)
#
# Spotify app credentials from https://developer.spotify.com/dashboard.
# Make sure the dashboard's "Redirect URIs" list contains the value of
# SPOTIFY_REDIRECT_URI below — Spotify refuses callbacks that don't
# match exactly.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://import.portcast.org/spotify/callback

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Used only for log lines and download filenames; safe to leave as the
# public URL.
PUBLIC_BASE_URL=https://import.portcast.org
