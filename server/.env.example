# Spotify app credentials from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret

# Must exactly match a redirect URI registered on the Spotify app.
# Local dev:   http://127.0.0.1:8000/spotify/callback
# Production:  https://import.portcast.org/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback

# Random secret used to sign the short-lived state + token cookies.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-a-random-48-byte-urlsafe-string

# Optional: override the public origin used in download filenames / log lines.
# PUBLIC_BASE_URL=https://import.portcast.org
